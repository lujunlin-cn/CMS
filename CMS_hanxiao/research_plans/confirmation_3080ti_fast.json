      "args": {
        "norm": "imagenet",
        "lr": 0.0003,
        "encoder_lr_multiplier": 1.0,
        "train_unit": "image",
        "loss": "bce",
        "eval_pool": "max"
      }
    },
    {
      "id": "C1_cs_lr01",
      "group": "cs_lr",
      "kind": "backbone",
      "model": "convnext_small",
      "args": {
        "norm": "imagenet",
        "lr": 0.0003,
        "encoder_lr_multiplier": 0.1,
        "train_unit": "image",
        "loss": "bce",
        "eval_pool": "max"
      }
    },
    {
      "id": "N0_eff_imagenet",
      "group": "eff_norm",
      "kind": "backbone",
      "model": "efficientnetv2_s",
      "args": {
        "norm": "imagenet",
        "lr": 0.0003,
        "encoder_lr_multiplier": 1.0,
        "train_unit": "image",
        "loss": "bce",
        "eval_pool": "max"
      }
    },
    {
      "id": "N1_eff_half",
      "group": "eff_norm",
      "kind": "backbone",
      "model": "efficientnetv2_s",
      "args": {
        "norm": "half",
        "lr": 0.0003,
        "encoder_lr_multiplier": 1.0,
        "train_unit": "image",
        "loss": "bce",
        "eval_pool": "max"
      }
    }
