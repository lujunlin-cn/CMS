{
  "name": "research_v2_3080ti_confirm_fast_01",
  "protocol": {
    "splits": [
      "train",
      "valid"
    ],
    "epochs": 12,
    "seeds": [
      20261024,
      20261025,
      20261026
    ],
    "size": 224,
    "weight_decay": 0.0001,
    "image_batch_size": 32,
    "study_batch_size": 4,
    "workers": 8,
    "amp_train": true,
    "fp32_validation": true,
    "tf32": false,
    "augmentations": "none",
    "metric": "valid_study_macro_auc_then_exact_macro_f1",
    "test_used": false,
    "hardware_note": "RTX 3080 Ti accelerated continuation: batch32, workers8; completed batch16 runs are retained and skipped; results remain a separate hardware-specific confirmation."
  },
  "jobs": [
    {
      "id": "C0_cs_p0",
