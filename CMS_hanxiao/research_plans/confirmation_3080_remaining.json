{
  "name": "research_v2_confirm_3080_remaining",
  "protocol": {
    "splits": [
      "train",
      "valid"
    ],
    "epochs": 12,
    "seeds": [
      20261024,
      20261025,
      20261026
    ],
    "size": 224,
    "weight_decay": 0.0001,
    "image_batch_size": 64,
    "study_batch_size": 4,
    "workers": 12,
    "amp_train": true,
    "fp32_validation": true,
    "tf32": false,
    "augmentations": "none",
    "metric": "valid_study_macro_auc_then_exact_macro_f1",
    "test_used": false,
    "hardware_note": "Remaining twelve jobs delegated to RTX 3080 Ti; batch32/workers8 for backbone jobs; results are transferred to 4090 for joint analysis."
  },
  "jobs": [
    {
      "id": "N1_eff_half",
      "group": "eff_norm",
      "kind": "backbone",
      "model": "efficientnetv2_s",
      "args": {
        "norm": "half",
        "lr": 0.0003,
        "encoder_lr_multiplier": 1.0,
        "train_unit": "image",
        "loss": "bce",
        "eval_pool": "max"
      }
    },
    {
      "id": "U0_unet_decoder",
      "group": "unet_structure",
      "kind": "unet",
      "model": "densenet121",
      "args": {
        "fusion": "decoder",
        "spatial_pool": "topk",
        "topk_ratio": 0.2,
        "study_pool": "mean",
        "lr": 0.0003,
        "encoder_lr_multiplier": 0.1,
        "freeze_encoder": true,
        "freeze_epochs": 1
      }
    },
    {
      "id": "U1_unet_global",
      "group": "unet_structure",
      "kind": "unet",
      "model": "densenet121",
      "args": {
        "fusion": "global",
        "spatial_pool": "topk",
        "topk_ratio": 0.2,
        "study_pool": "mean",
        "lr": 0.0003,
        "encoder_lr_multiplier": 0.1,
        "freeze_encoder": true,
        "freeze_epochs": 1
      }
    },
    {
      "id": "U2_unet_residual",
      "group": "unet_structure",
      "kind": "unet",
      "model": "densenet121",
      "args": {
        "fusion": "residual",
        "spatial_pool": "topk",
        "topk_ratio": 0.2,
        "study_pool": "mean",
        "lr": 0.0003,
        "encoder_lr_multiplier": 0.1,
        "freeze_encoder": true,
        "freeze_epochs": 1
      }
    }
  ]
}
